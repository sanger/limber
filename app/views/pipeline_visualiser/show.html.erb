<div class="container-fluid bg-dark text-light py-4" style="min-height: calc(100vh - 73px);">
  <div class="row">
    <div class="col-md-12">
      <h1>Pipeline Visualiser</h1>
      <div id="error-message" class="alert alert-danger mt-3" style="display: none;"></div>
      <div id="loading" class="alert alert-info mt-3" style="display: none;">Loading...</div>      

      <div class="form-group mb-3">
        <label for="barcode-input">Enter Barcode:</label>
        <div class="input-group">
          <input
            type="text"
            id="barcode-input"
            class="form-control bg-dark text-light border-secondary"
            placeholder="e.g. SQPP-12345"
            value="<%= params[:id] %>">
          <button id="search-btn" class="btn btn-primary">Search</button>
        </div>
      </div>

      <div style="display: flex; gap: 12px; margin-bottom: 8px;">
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 14px; height: 14px; border-radius: 50%; background: #666; border: 2px solid #e8a838;"></div>
          <span style="font-size: 13px;">Searched labware</span>
        </div>
      </div>

      <div class="mb-2">
        <strong class="small">Purpose Types</strong>
        <ul id="pipelines-key" class="list-unstyled small mb-3"></ul>
      </div>

      <div id="graph" class="bg-dark" style="width: 100%; height: 600px; border: 1px solid #444;"></div>

    </div>
  </div>
</div>

<%= vite_javascript_tag 'entrypoints/pages/pipeline_visualiser.js', defer: true %>
